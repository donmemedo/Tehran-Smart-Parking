# Copy to .env for docker compose. Nothing here is a secret; do not commit a real .env.

# --- Frontend (Next.js) ---------------------------------------------------------------
# Where the frontend server proxies /api/* and /ws/* to. Inside compose this is the backend
# service on the private network. It is a BUILD arg as well as runtime env (Next bakes rewrites
# at build time), so re-run `docker compose build frontend` after changing it.
# Running `npm run dev` outside docker instead? Export BACKEND_URL=http://127.0.0.1:8090 there.
BACKEND_URL=http://backend:8000

# Optional. Only set when the live-feed WebSocket is served from a different origin than the
# page (e.g. wss://live.example.org/ws/live). Empty = same-origin /ws/live. Build-time value.
NEXT_PUBLIC_WS_URL=

# --- Backend (FastAPI) ----------------------------------------------------------------
# Comma-separated browser origins allowed for cross-origin API calls (CORS). The app itself is
# same-origin through the proxy, so this only matters for other sites that call the API.
# Set to your public https origin(s) in production.
PH_ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Comma-separated Host header allowlist (TrustedHost). Keep "backend" for the internal proxy hop
# and localhost/127.0.0.1 for the container healthcheck; add your public hostname.
PH_ALLOWED_HOSTS=backend,localhost,127.0.0.1

# 1 enables the demo wallet top-up endpoint (free money). Keep 0 anywhere that is not a demo.
PH_DEMO_TOPUP=0

# Per-client request budget per minute (token bucket) before the API answers 429.
PH_RATE_LIMIT_PER_MIN=240

# --- Proxy and network (docker compose) -----------------------------------------------
# Private network and the fixed address of the proxy container. The backend trusts
# X-Forwarded-For only from PH_PROXY_IP. Change both if 10.89.28.0/24 clashes with a network
# you already have (check: docker network ls -q | xargs docker network inspect -f '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}').
PH_SUBNET=10.89.28.0/24
PH_PROXY_IP=10.89.28.2

# 1 adds upgrade-insecure-requests to the frontend CSP. Only turn on behind HTTPS. Build-time value.
CSP_UPGRADE_INSECURE=0
